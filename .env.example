# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
# 공공데이터포털 인증키 (Decoding 키). 활용신청이 승인된 모든 API에 하나로 사용
DATA_GO_KR_KEY=
# 제주데이터허브 프로젝트 키 (jejudatahub.net → 마이페이지 → 프로젝트에 신청한 API 를 담으면 발급)
JEJU_DATAHUB_KEY=
# 강사가 나눠 준 Claude 키 (GitHub·카톡 공개방에 올리지 말 것)
ANTHROPIC_API_KEY= 

# 카카오맵 JavaScript 키 (브라우저용 공개 키 — 카카오 디벨로퍼스 > 앱 > 플랫폼 > Web 에 사이트 도메인 등록 필수)
VITE_KAKAO_MAP_KEY= 

# 카카오 REST API 키 — 서버 전용 (AI 가 유명 장소를 정확히 찾도록 카카오 장소 검색에 사용, 선택)
# 카카오 디벨로퍼스 > 앱 키 > REST API 키. 브라우저 키(VITE_KAKAO_MAP_KEY)와 다른 값이며 VITE_ 를 붙이지 마세요
KAKAO_REST_KEY=
